/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  X-Frame-Options: DENY

# Hashed assets: max-age=31536000, immutable
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Records, indexes, lists, file-links, and JSON texts from database:
# s-maxage=604800 (Cloudflare Edge stores for 1 full week / 7 days -> 1st user hits DB, all others hit Cache for a week)
# max-age=3600 (Browser cache 1 hour), stale-while-revalidate=86400 (background revalidation for 24h), stale-if-error=604800 (failover 7 days)
/data/*
  Cache-Control: public, max-age=3600, s-maxage=604800, stale-while-revalidate=86400, stale-if-error=604800
  Access-Control-Allow-Origin: *

# All JSON API responses, texts, and manifests: 1 week minimum Edge cache
/*.json
  Cache-Control: public, max-age=3600, s-maxage=604800, stale-while-revalidate=86400, stale-if-error=604800
  Access-Control-Allow-Origin: *

# Static PDFs
/*.pdf
  Cache-Control: public, max-age=86400, s-maxage=604800, stale-while-revalidate=300
  Access-Control-Allow-Origin: *

# HTML pages: max-age=300, s-maxage=86400
/*.html
  Cache-Control: public, max-age=300, s-maxage=86400, stale-while-revalidate=60

# Admin responses: no-store
/api/admin/*
  Cache-Control: no-store
  Access-Control-Allow-Origin: *
  Access-Control-Allow-Methods: GET, POST, OPTIONS
  Access-Control-Allow-Headers: Content-Type, Authorization

# ---------------------------------------------------------------------------
# /store/*.json : public text snapshot (at most 20 files). Already covered by the
# "/*.json" rule above (browser 1h, Cloudflare edge 1 week). Each file is requested
# as ?v=<content hash>, so a new version is picked up as soon as the manifest changes.
# The manifest has NO ".json" extension on purpose, so it gets its own short cache:
# ---------------------------------------------------------------------------
/store/manifest
  Cache-Control: public, max-age=300, s-maxage=300
  Content-Type: application/json; charset=utf-8
  Access-Control-Allow-Origin: *
